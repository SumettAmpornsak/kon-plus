{
  "rules": {
    "system": {
      ".read": "auth != null",

      "settings": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      },

      "telegram": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'"
      },

      "ownerUid": {
        ".write": "auth != null && !data.exists()"
      }
    },

    "users": {
      ".read": "auth != null",

      "$uid": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || (!root.child('system/ownerUid').exists()) || (!data.exists() && auth.uid === $uid && auth.token.email != null && root.child('userInvites').child(auth.token.email.toLowerCase().replace('.', '%2E')).child('enabled').val() === true && newData.child('email').val() === auth.token.email.toLowerCase() && newData.child('role').val() === root.child('userInvites').child(auth.token.email.toLowerCase().replace('.', '%2E')).child('role').val() && newData.child('status').val() === root.child('userInvites').child(auth.token.email.toLowerCase().replace('.', '%2E')).child('status').val()))",

        "displayName": {
          ".write": "auth != null && auth.uid === $uid"
        },

        "photoURL": {
          ".write": "auth != null && auth.uid === $uid"
        },

        "lastLoginAt": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "userInvites": {
      "$emailKey": {
        ".read": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', '%2E')",

        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",

        "claimedUid": {
          ".write": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', '%2E') && !data.exists() && newData.val() === auth.uid"
        }
      }
    },

    "employees": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'supervisor')",

      "$empId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'supervisor')"
      }
    },

    "machines": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'supervisor')",

      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'supervisor')"
    },

    "daily": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'supervisor')",

      "$date": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'supervisor')"
      }
    },

    "auditLogs": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'supervisor')",

      "$logId": {
        ".write": "auth != null && !data.exists() && newData.exists()"
      }
    },

    "loginHistory": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'owner'",

      "$loginId": {
        ".write": "auth != null && !data.exists() && newData.exists()"
      }
    },

    "backups": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'supervisor')",

      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'owner' || root.child('users').child(auth.uid).child('role').val() === 'supervisor')"
    },

    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}